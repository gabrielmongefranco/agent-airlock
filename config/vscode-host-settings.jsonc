// with this program. If not, see <https://www.gnu.org/licenses/>.
{
    // Use podman instead of Docker for every Dev Containers operation.
    "dev.containers.dockerPath": "podman",

    // Installed inside every container you attach to, never on the host.
    "dev.containers.defaultExtensions": [
        "anthropic.claude-code",
        "openai.chatgpt"
    ],

    // Windows only: run podman commands inside the WSL2 distro that hosts
    // the airlock. Set the distro name to match "wsl --list".
    "dev.containers.executeInWSL": false,
    "dev.containers.executeInWSLDistro": "Ubuntu"
}
