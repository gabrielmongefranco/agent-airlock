# API keys are optional. Leave them out to use browser (subscription) login.
# ANTHROPIC_API_KEY=EXAMPLE_API_KEY
# OPENAI_API_KEY=EXAMPLE_API_KEY

# Local inference endpoints as seen from inside the container.
LOCAL_LLM_BASE_URL=http://host.containers.internal:8080/v1
OLLAMA_HOST=http://host.containers.internal:11434
