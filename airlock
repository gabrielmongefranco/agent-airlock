set -euo pipefail

### Load Configuration ###
# Every value can be overridden from the environment. Paths on the host side
# are the user's; paths on the container side are fixed by the Containerfile.
BOX_NAME="${AIRLOCK_NAME:-airlock}"
IMAGE="${AIRLOCK_IMAGE:-localhost/agentairlock:latest}"
VOLUME="${AIRLOCK_VOLUME:-${BOX_NAME}-home}"
GIT_DIR="${AIRLOCK_GIT_DIR:-${HOME}/git}"
CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/airlock"
ENV_FILE_DEFAULT="${CONFIG_DIR}/env"
DEV_PORT_RANGE="${AIRLOCK_PORTS:-4000-4010}"
CODEX_LOGIN_PORT="${AIRLOCK_CODEX_LOGIN_PORT:-1455}"
LOCAL_LLM_BASE_URL="${LOCAL_LLM_BASE_URL:-http://host.containers.internal:8080/v1}"
OLLAMA_HOST="${OLLAMA_HOST:-http://host.containers.internal:11434}"
# --no-sandbox: Chromium's setuid sandbox cannot start inside a rootless
# container, and the container itself is the isolation boundary.
# --disable-gpu avoids GPU crashes on devices the container cannot see.
CODE_ARGS="${AIRLOCK_CODE_ARGS:---disable-gpu --no-sandbox}"
# Where the airlock symlink lives; install creates it, uninstall removes it.
BIN_DIR="${AIRLOCK_BIN_DIR:-${HOME}/.local/bin}"

# Container-side constants. They match the Containerfile.
CONTAINER_HOME="/home/agent"
CONTAINER_GIT_DIR="${CONTAINER_HOME}/git"
CONTAINER_UID=1000
CONTAINER_GID=1000
WAYLAND_SOCKET_IN_BOX="/tmp/wayland-host"
# Address pasta maps to the host loopback so services bound to 127.0.0.1 on
# the host (llama-swap, the LLM gateway) are reachable from the container.
HOST_LOOPBACK_ALIAS="169.254.1.3"

# The launcher is usually run through a symlink in ~/.local/bin, so the link
# chain is resolved first; the Containerfile lives next to the real script.
script_path="${BASH_SOURCE[0]}"
while [[ -L "${script_path}" ]]; do
    script_dir="$(cd -P "$(dirname "${script_path}")" && pwd)"
    script_path="$(readlink "${script_path}")"
    [[ "${script_path}" == /* ]] || script_path="${script_dir}/${script_path}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${script_path}")" && pwd)"
unset script_path script_dir
HOST_OS="$(uname -s)"

### Helpers ###
log() { printf '%s\n' "$*" >&2; }
die() { log "error: $*"; exit 1; }

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  install [--gui]            One-time setup: podman if missing, the PATH link,
                             the doctor check, and the image build.
  build [--gui]              Build or rebuild the image. --gui also installs
                             VS Code in it.
  up [--gui] [--env-file F]  Create or start the container by hand; commands
                             that need it also start it automatically.
                             --gui shares the Wayland display.
  down                       Stop the container.
  shell                      Open a shell inside the container at ${CONTAINER_GIT_DIR}.
  vscode [--container|--host] [PATH]
                             Open VS Code on the container. --container runs it
                             inside (the default when up used --gui, Linux only);
                             --host attaches the host VS Code instead.
                             Shorthands: code = vscode --container,
                             open = vscode --host.
  attach                     Print the manual steps to attach the host VS Code.
  login <claude|codex|gh>    Run the browser-based login for a tool inside the container.
  update                     Update the agent CLIs inside the container.
  snapshot [TAG]             Save the container's current image layer under a tag.
  status                     Show container, image, and volume state.
  doctor                     Check the host for everything the airlock needs.
  reset [--purge]            Remove the container. --purge also deletes the home volume.
  uninstall                  Remove the container, home volume, image, PATH link,
                             and optionally the config directory.

Hosts: Linux desktops and WSL2 support every command; macOS supports all but
vscode --container, since it has no Wayland display.

Environment overrides: AIRLOCK_NAME, AIRLOCK_IMAGE, AIRLOCK_VOLUME,
AIRLOCK_GIT_DIR, AIRLOCK_BIN_DIR, AIRLOCK_PORTS, AIRLOCK_CODE_ARGS,
LOCAL_LLM_BASE_URL, OLLAMA_HOST. An env file at ${ENV_FILE_DEFAULT} is passed
to the container when present (see config/env.example).
EOF
}

confirm() {
    # Asks a yes/no question on the terminal. Returns 1 unless the answer is y.
    local answer
    read -r -p "$1 [y/N] " answer </dev/tty
    [[ "${answer}" == "y" || "${answer}" == "Y" ]]
}

is_linux() { [[ "${HOST_OS}" == "Linux" ]]; }
is_macos() { [[ "${HOST_OS}" == "Darwin" ]]; }
is_wsl() {
    # WSL2 kernels identify themselves in /proc/version.
    is_linux && [[ -r /proc/version ]] && grep -qi microsoft /proc/version
}

container_exists() { podman container exists "${BOX_NAME}" 2>/dev/null; }
container_running() {
    [[ "$(podman inspect -f '{{.State.Running}}' "${BOX_NAME}" 2>/dev/null)" == "true" ]]
}
container_label() {
    # Prints the value of a container label, or nothing when unset.
    podman inspect -f "{{ index .Config.Labels \"$1\" }}" "${BOX_NAME}" 2>/dev/null || true
}

podman_version_ok() {
    # host.containers.internal only resolves reliably from podman 5.3 on.
    local version major minor
    version="$(podman version --format '{{.Client.Version}}' 2>/dev/null || echo 0.0)"
    major="${version%%.*}"
    minor="${version#*.}"; minor="${minor%%.*}"
    (( major > 5 || (major == 5 && minor >= 3) ))
}

require_podman() {
    command -v podman >/dev/null 2>&1 || die "podman is not installed"
    if is_macos; then
        podman info >/dev/null 2>&1 \
            || die "podman machine is not running; start it with: podman machine start"
    fi
    podman_version_ok || log "warning: podman 5.3 or newer is recommended for host.containers.internal"
}

selinux_active() {
    is_linux && command -v getenforce >/dev/null 2>&1 \
        && [[ "$(getenforce)" != "Disabled" ]]
}

git_dir_relabeled() {
    stat --format='%C' "${GIT_DIR}" 2>/dev/null | grep -q 'container_file_t'
}

ensure_git_dir_label() {
    # Rootless podman under SELinux cannot read a bind mount unless the files
    # carry the container_file_t type. A one-time relabel avoids the per-start
    # walk that the :Z mount option would do over the whole tree.
    selinux_active || return 0
    git_dir_relabeled && return 0
    log "SELinux is active and ${GIT_DIR} is not labeled for container access."
    log "Relabeling changes the SELinux type on every file under ${GIT_DIR}."
    log "Host tools keep working; restorecon would undo it."
    confirm "Run: chcon -R -t container_file_t ${GIT_DIR} ?" \
        || die "the container cannot read ${GIT_DIR} without the relabel"
    chcon -R -t container_file_t "${GIT_DIR}"
}

wayland_socket_path() {
    # Prints the real path of the session's Wayland socket. Under WSLg the
    # entry in XDG_RUNTIME_DIR is a symlink into /mnt/wslg, so it is resolved
    # before being bind-mounted.
    [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]] || return 1
    local candidate="${WAYLAND_DISPLAY}"
    [[ "${candidate}" == /* ]] || candidate="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
    candidate="$(readlink -f "${candidate}" 2>/dev/null || true)"
    [[ -S "${candidate}" ]] || return 1
    printf '%s' "${candidate}"
}

wsl_gateway() {
    # The address of the Windows host as seen from a NAT-mode WSL2 distro.
    ip route show default 2>/dev/null | awk '/default/ {print $3; exit}'
}

host_timezone() {
    if [[ -n "${TZ:-}" ]]; then
        printf '%s' "${TZ}"
    elif is_linux && command -v timedatectl >/dev/null 2>&1; then
        timedatectl show -p Timezone --value 2>/dev/null || printf 'UTC'
    elif is_linux && [[ -r /etc/timezone ]]; then
        cat /etc/timezone
    elif is_macos && [[ -L /etc/localtime ]]; then
        readlink /etc/localtime | sed 's#.*/zoneinfo/##'
    else
        printf 'UTC'
    fi
}

resolve_env_file() {
    # Prints the env file to use, or nothing. An explicit path must exist.
    local requested="$1"
    if [[ -n "${requested}" ]]; then
        [[ -f "${requested}" ]] || die "env file not found: ${requested}"
        printf '%s' "${requested}"
    elif [[ -f "${ENV_FILE_DEFAULT}" ]]; then
        printf '%s' "${ENV_FILE_DEFAULT}"
    fi
}

seed_git_identity() {
    # Copies only the commit identity from the host, never the whole
    # .gitconfig, which may hold credential helpers or signing keys.
    local name email
    name="$(git config --global user.name 2>/dev/null || true)"
    email="$(git config --global user.email 2>/dev/null || true)"
    [[ -n "${name}" && -n "${email}" ]] || return 0
    if [[ -z "$(podman exec "${BOX_NAME}" git config --global user.name 2>/dev/null || true)" ]]; then
        podman exec "${BOX_NAME}" git config --global user.name "${name}"
        podman exec "${BOX_NAME}" git config --global user.email "${email}"
        log "Seeded git identity in the container from the host global config."
    fi
}

container_path_for() {
    # Translates a host path under GIT_DIR to its container path. Paths that
    # are already container paths pass through unchanged.
    local target="$1"
    case "${target}" in
        "${GIT_DIR}"*) printf '%s' "${CONTAINER_GIT_DIR}${target#"${GIT_DIR}"}" ;;
        *) printf '%s' "${target}" ;;
    esac
}

hex_encode() {
    # Lowercase hex of the argument, with no separators.
    printf '%s' "$1" | od -An -tx1 | tr -d ' \n'
}

ensure_running() {
    # Commands that need the container start it themselves; a separate "up"
    # is only needed to pass flags such as --env-file. A missing container
    # is created with --gui when the image was built with it and a Wayland
    # display is present, matching how the airlock was installed.
    container_running && return 0
    if container_exists; then
        cmd_up
    elif [[ "$(podman image inspect -f '{{ index .Config.Labels "airlock.gui" }}' "${IMAGE}" 2>/dev/null)" == "1" ]] \
            && is_linux && wayland_socket_path >/dev/null; then
        log "${BOX_NAME} is not running; starting it with --gui."
        cmd_up --gui
    else
        log "${BOX_NAME} is not running; starting it."
        cmd_up
    fi
}

install_podman_if_missing() {
    # Installing a system package changes the host, so every path below asks
    # first. On Windows the launcher runs inside a WSL2 distro, which takes
    # the same dnf or apt-get path as any other Linux host.
    if ! command -v podman >/dev/null 2>&1; then
        if is_macos; then
            command -v brew >/dev/null 2>&1 \
                || die "podman is missing and Homebrew was not found; install podman first (https://podman.io)"
            confirm "podman is missing. Install it with: brew install podman ?" || die "podman is required"
            brew install podman
        elif command -v dnf >/dev/null 2>&1; then
            confirm "podman is missing. Install it with: sudo dnf install -y podman ?" || die "podman is required"
            sudo dnf install -y podman
        elif command -v apt-get >/dev/null 2>&1; then
            confirm "podman is missing. Install it with: sudo apt-get install -y podman ?" || die "podman is required"
            sudo apt-get update && sudo apt-get install -y podman
        else
            die "podman is missing and no supported package manager (dnf, apt-get, brew) was found"
        fi
    fi
    if is_macos && ! podman info >/dev/null 2>&1; then
        confirm "The podman machine is not running. Run: podman machine init --now ?" \
            || die "the podman machine must be running"
        podman machine init --now 2>/dev/null || podman machine start
    fi
}

link_launcher() {
    # A plain file at the link path is someone else's tool; leave it alone.
    if [[ -e "${BIN_DIR}/airlock" && ! -L "${BIN_DIR}/airlock" ]]; then
        log "warning: ${BIN_DIR}/airlock exists and is not a symlink; leaving it in place"
        return 0
    fi
    mkdir -p "${BIN_DIR}"
    ln -sf "${SCRIPT_DIR}/airlock" "${BIN_DIR}/airlock"
    log "Linked ${BIN_DIR}/airlock -> ${SCRIPT_DIR}/airlock"
    case ":${PATH}:" in
        *":${BIN_DIR}:"*) ;;
        *) log "note: ${BIN_DIR} is not on your PATH; add it, or call ${SCRIPT_DIR}/airlock directly" ;;
    esac
}

### Commands ###
cmd_install() {
    local gui=0 up_cmd
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gui) gui=1 ;;
            *) die "unknown option for install: $1" ;;
        esac
        shift
    done
    if ! is_linux && ! is_macos; then
        die "run install from a Linux shell; on Windows, enable WSL2 first (wsl --install) and run it inside the distro"
    fi
    install_podman_if_missing
    # A downloaded zip loses the executable bits that a git clone keeps.
    chmod +x "${SCRIPT_DIR}/airlock" "${SCRIPT_DIR}/entrypoint.sh"
    link_launcher
    cmd_doctor
    if (( gui )); then cmd_build --gui; else cmd_build; fi
    up_cmd="airlock up"; (( gui )) && up_cmd="airlock up --gui"
    log "Install finished. Next: ${up_cmd}   then: airlock login claude   and: airlock login codex"
}

cmd_build() {
    local gui=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gui) gui=1 ;;
            *) die "unknown option for build: $1" ;;
        esac
        shift
    done
    if (( gui )) && ! is_linux; then
        die "--gui needs a Linux or WSL2 host with a Wayland session"
    fi
    require_podman
    [[ -f "${SCRIPT_DIR}/Containerfile" ]] || die "Containerfile not found next to this script"
    podman build \
        --build-arg "WITH_GUI=${gui}" \
        --build-arg "AGENT_UID=${CONTAINER_UID}" \
        --build-arg "AGENT_GID=${CONTAINER_GID}" \
        --label "airlock.gui=${gui}" \
        -t "${IMAGE}" \
        -f "${SCRIPT_DIR}/Containerfile" \
        "${SCRIPT_DIR}"
    log "Built ${IMAGE} (gui=${gui})."
}

cmd_up() {
    local gui=0 env_file_arg="" env_file wayland_socket
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --gui) gui=1 ;;
            --env-file) [[ $# -ge 2 ]] || die "--env-file needs a path"; env_file_arg="$2"; shift ;;
            *) die "unknown option for up: $1" ;;
        esac
        shift
    done
    require_podman

    if container_exists; then
        if container_running; then
            log "${BOX_NAME} is already running."
        else
            podman start "${BOX_NAME}" >/dev/null
            log "Started ${BOX_NAME}."
        fi
        seed_git_identity
        return 0
    fi

    [[ -d "${GIT_DIR}" ]] || die "git directory not found: ${GIT_DIR}"
    podman image exists "${IMAGE}" || die "image ${IMAGE} not found; run: $(basename "$0") build"
    env_file="$(resolve_env_file "${env_file_arg}")"

    local -a args=(
        run -d
        --name "${BOX_NAME}"
        # A real init as PID 1 forwards SIGTERM to the idle sleep, so "down"
        # stops the container promptly instead of escalating to SIGKILL.
        --init
        --label "airlock.gui=${gui}"
        --userns "keep-id:uid=${CONTAINER_UID},gid=${CONTAINER_GID}"
        --shm-size 1g
        -v "${VOLUME}:${CONTAINER_HOME}"
        -v "${GIT_DIR}:${CONTAINER_GIT_DIR}"
        -e "TZ=$(host_timezone)"
        -e "LOCAL_LLM_BASE_URL=${LOCAL_LLM_BASE_URL}"
        -e "OLLAMA_HOST=${OLLAMA_HOST}"
        -p "127.0.0.1:${CODEX_LOGIN_PORT}:${CODEX_LOGIN_PORT}"
        -p "127.0.0.1:${DEV_PORT_RANGE}:${DEV_PORT_RANGE}"
    )

    if is_linux; then
        ensure_git_dir_label
        # pasta copies the host address into the container, so the host's
        # loopback services need an explicit alias to be reachable. Inside
        # WSL2 this reaches the distro's loopback, which is the Windows
        # loopback only under mirrored networking.
        args+=(
            --network "pasta:--map-host-loopback,${HOST_LOOPBACK_ALIAS}"
            --add-host "host.containers.internal:${HOST_LOOPBACK_ALIAS}"
        )
    fi

    if (( gui )); then
        is_linux || die "--gui needs a Linux or WSL2 host with a Wayland session"
        wayland_socket="$(wayland_socket_path)" \
            || die "no Wayland socket found; WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-unset}"
        [[ "$(podman image inspect -f '{{ index .Config.Labels "airlock.gui" }}' "${IMAGE}")" == "1" ]] \
            || die "image was built without --gui; run: $(basename "$0") build --gui"
        # label=disable is required for the container to open the host's
        # compositor socket under SELinux. The mount namespace still holds
        # only ~/git and the home volume.
        args+=(
            --security-opt label=disable
            -e "WAYLAND_DISPLAY=${WAYLAND_SOCKET_IN_BOX}"
            -e "ELECTRON_OZONE_PLATFORM_HINT=wayland"
            -v "${wayland_socket}:${WAYLAND_SOCKET_IN_BOX}"
        )
    fi

    if [[ -n "${env_file}" ]]; then args+=(--env-file "${env_file}"); fi
    args+=("${IMAGE}")

    podman "${args[@]}" >/dev/null
    log "Created and started ${BOX_NAME} (gui=${gui})."
    seed_git_identity
    log "Next: $(basename "$0") login claude   and   $(basename "$0") login codex"
}

cmd_down() {
    require_podman
    container_running || { log "${BOX_NAME} is not running."; return 0; }
    podman stop "${BOX_NAME}" >/dev/null
    log "Stopped ${BOX_NAME}."
}

cmd_shell() {
    require_podman
    ensure_running
    exec podman exec -it -w "${CONTAINER_GIT_DIR}" "${BOX_NAME}" bash -l
}

cmd_vscode() {
    # VS Code is an Electron application, so Chromium flags such as
    # --no-sandbox in CODE_ARGS apply to it.
    local where="" target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --container) where=container ;;
            --host) where=host ;;
            -*) die "unknown option for vscode: $1" ;;
            *) target="$1" ;;
        esac
        shift
    done
    if [[ -z "${where}" ]]; then
        # Default follows how the container was started: a --gui container
        # runs the editor inside; anything else attaches the host editor.
        if is_linux && [[ "$(container_label airlock.gui)" == "1" ]]; then
            where=container
        else
            where=host
        fi
    fi
    if [[ "${where}" == "container" ]]; then
        vscode_in_container ${target:+"${target}"}
    else
        vscode_on_host ${target:+"${target}"}
    fi
}

vscode_in_container() {
    local target
    target="$(container_path_for "${1:-${CONTAINER_GIT_DIR}}")"
    require_podman
    is_linux || die "vscode --container needs a Linux or WSL2 host; use vscode --host instead"
    ensure_running
    [[ "$(container_label airlock.gui)" == "1" ]] \
        || die "${BOX_NAME} was started without --gui; run: $(basename "$0") reset && $(basename "$0") up --gui"
    # shellcheck disable=SC2086
    podman exec -d "${BOX_NAME}" code ${CODE_ARGS} "${target}"
    log "Launched VS Code inside ${BOX_NAME} at ${target}."
    log "No window? See docs/troubleshooting.md; run the same command in the"
    log "foreground to read the error: podman exec -it ${BOX_NAME} code ${CODE_ARGS} --verbose"
}

vscode_on_host() {
    # Opens the host VS Code already attached to the container, using the
    # folder URI the Dev Containers extension uses for attached containers.
    local target authority host_settings
    target="$(container_path_for "${1:-${CONTAINER_GIT_DIR}}")"
    require_podman
    ensure_running
    command -v code >/dev/null 2>&1 || die "the host 'code' command is not on PATH"
    # Without dev.containers.dockerPath=podman in the host settings, the
    # Dev Containers extension drives Docker, cannot find this container,
    # and offers to create a .devcontainer instead of attaching.
    if is_macos; then
        host_settings="${HOME}/Library/Application Support/Code/User/settings.json"
    else
        host_settings="${XDG_CONFIG_HOME:-${HOME}/.config}/Code/User/settings.json"
    fi
    if [[ ! -r "${host_settings}" ]] || ! grep -q 'dev.containers.dockerPath' "${host_settings}"; then
        log "warning: the host VS Code is not configured for podman yet. Merge"
        log "config/vscode-host-settings.jsonc into your user settings first;"
        log "$(basename "$0") attach prints the steps."
    fi
    authority="attached-container+$(hex_encode "{\"containerName\":\"/${BOX_NAME}\"}")"
    code --folder-uri "vscode-remote://${authority}${target}"
    log "Opened ${target} in the host VS Code attached to ${BOX_NAME}."
}

cmd_attach() {
    cat <<EOF
Attach the host VS Code to the running container by hand:

1. Merge config/vscode-host-settings.jsonc into your host VS Code user settings
   (dev.containers.dockerPath = podman, default extensions = the agent extensions).
2. Install the "Dev Containers" extension on the host if it is missing.
3. Command Palette > "Dev Containers: Attach to Running Container..." > ${BOX_NAME}
4. In the new window, open ${CONTAINER_GIT_DIR}/<repo>.

On Windows, open a Remote-WSL window for the distro that runs podman first, set
"dev.containers.executeInWSL": true, and attach from that window.

Extensions you install from that window go into the container, never the host.
Ports that servers open inside the container are forwarded to host localhost
automatically; the Ports panel shows them. "$(basename "$0") open <path>" does
steps 3 and 4 in one command once the settings are in place.
EOF
}

cmd_login() {
    local tool="${1:-}"
    require_podman
    ensure_running
    # Every login starts in ~/git so tools that treat the working directory
    # as the workspace (Claude Code's trust prompt) see the shared projects
    # tree instead of the container home.
    case "${tool}" in
        claude)
            log "Claude Code prints a login URL. Open it in the host browser, then paste the code back here."
            log "The container has no browser, so the copy-and-paste step is expected."
            log "When the login finishes, type /exit to leave Claude Code and return to the host shell."
            exec podman exec -it -w "${CONTAINER_GIT_DIR}" "${BOX_NAME}" claude
            ;;
        codex)
            log "Codex prints a login URL. Open it in the host browser; the callback returns on port ${CODEX_LOGIN_PORT}."
            exec podman exec -it -w "${CONTAINER_GIT_DIR}" "${BOX_NAME}" codex login
            ;;
        gh)
            log "Use a fine-grained token limited to the repositories the agents work on."
            exec podman exec -it -w "${CONTAINER_GIT_DIR}" "${BOX_NAME}" gh auth login
            ;;
        *)
            die "login needs one of: claude, codex, gh"
            ;;
    esac
}

cmd_update() {
    require_podman
    ensure_running
    podman exec "${BOX_NAME}" bash -lc 'claude update; npm update -g'
}

cmd_snapshot() {
    local tag="${1:-snapshot-$(date +%Y%m%d-%H%M)}"
    require_podman
    container_exists || die "${BOX_NAME} does not exist"
    # podman commit captures the image layer (apt packages, system files).
    # The home volume is not part of an image; back it up with podman volume export.
    podman commit "${BOX_NAME}" "localhost/agentairlock:${tag}" >/dev/null
    log "Saved localhost/agentairlock:${tag}. The home volume is separate; export it with:"
    log "  podman volume export ${VOLUME} --output ${BOX_NAME}-home.tar"
}

cmd_status() {
    require_podman
    if container_exists; then
        podman ps -a --filter "name=^${BOX_NAME}\$" --format 'Container: {{.Names}}  {{.Status}}  image={{.Image}}'
        log "gui=$(container_label airlock.gui)"
    else
        log "Container: ${BOX_NAME} does not exist"
    fi
    if podman image exists "${IMAGE}"; then
        podman image inspect -f 'Image: {{.Id}}  created={{.Created}}' "${IMAGE}" | cut -c1-90
    else
        log "Image: ${IMAGE} not built"
    fi
    if podman volume exists "${VOLUME}"; then
        podman volume inspect -f 'Volume: {{.Name}}  {{.Mountpoint}}' "${VOLUME}"
    else
        log "Volume: ${VOLUME} not created"
    fi
}

cmd_doctor() {
    # Line labels: fail = must be fixed before the airlock can run;
    # warn = something will misbehave until fixed; info = context only.
    local ok=1 port gateway
    if command -v podman >/dev/null 2>&1; then
        log "ok    podman $(podman version --format '{{.Client.Version}}')"
        podman_version_ok || log "warn  podman 5.3 or newer is recommended for host.containers.internal"
    else
        log "fail  podman is not installed"; ok=0
    fi
    if is_macos; then
        if podman info >/dev/null 2>&1; then
            log "ok    podman machine is running"
        else
            log "fail  podman machine is not running; start it with: podman machine start"; ok=0
        fi
    fi
    if is_linux && [[ -r /etc/subuid ]] && ! grep -qE "^($(id -un)|$(id -u)):" /etc/subuid; then
        log "fail  no /etc/subuid entry for $(id -un); rootless podman needs one (man subuid)"; ok=0
    fi
    if is_wsl; then
        gateway="$(wsl_gateway)"
        log "info  WSL2 host; Windows gateway address (NAT mode): ${gateway:-unknown}"
        log "info  if the LLM server runs on Windows under NAT networking, set"
        log "      LOCAL_LLM_BASE_URL=http://${gateway:-<gateway>}:8080/v1 and OLLAMA_HOST=http://${gateway:-<gateway>}:11434"
        log "      (under mirrored networking the defaults already reach the Windows loopback)"
    fi
    if [[ -d "${GIT_DIR}" ]]; then
        log "ok    git dir ${GIT_DIR}"
    else
        log "fail  git dir ${GIT_DIR} missing; create it or set AIRLOCK_GIT_DIR"; ok=0
    fi
    if selinux_active; then
        if git_dir_relabeled; then
            log "ok    SELinux: ${GIT_DIR} is labeled container_file_t"
        else
            log "warn  SELinux: ${GIT_DIR} needs a one-time relabel; 'up' offers it"
        fi
    fi
    if is_linux; then
        if wayland_socket_path >/dev/null; then
            log "ok    Wayland socket $(wayland_socket_path) (--gui available)"
        else
            log "info  no Wayland session socket (--gui unavailable; use 'open' instead of 'code')"
        fi
    fi
    if [[ -f "${ENV_FILE_DEFAULT}" ]]; then
        log "info  env file ${ENV_FILE_DEFAULT} will be passed to the container"
    else
        log "info  no env file (browser login mode)"
    fi
    for port in 8080 11434; do
        if command -v curl >/dev/null 2>&1 && curl -s -m 2 -o /dev/null "http://127.0.0.1:${port}/"; then
            log "info  host LLM port ${port} is listening"
        else
            log "info  host LLM port ${port} is not answering; local models stay unavailable until it does"
        fi
    done
    if (( ok )); then
        log "doctor: ready (warn lines are worth fixing; info lines need no action)"
    else
        die "doctor: fix the fail lines above"
    fi
}

cmd_reset() {
    local purge=0
    [[ "${1:-}" == "--purge" ]] && purge=1
    require_podman
    if container_exists; then
        confirm "Remove container ${BOX_NAME}? (apt packages installed inside are lost; the home volume stays)" \
            || die "cancelled"
        podman rm -f "${BOX_NAME}" >/dev/null
        log "Removed ${BOX_NAME}."
    fi
    if (( purge )) && podman volume exists "${VOLUME}"; then
        confirm "Delete home volume ${VOLUME}? (logins, installed agent tools, and settings are lost)" \
            || die "cancelled"
        podman volume rm "${VOLUME}" >/dev/null
        log "Deleted ${VOLUME}."
    fi
}

cmd_uninstall() {
    local repo="${IMAGE%%:*}" tags
    if command -v podman >/dev/null 2>&1; then
        if container_exists; then
            if confirm "Remove container ${BOX_NAME}?"; then
                podman rm -f "${BOX_NAME}" >/dev/null; log "Removed container ${BOX_NAME}."
            else
                log "Kept container ${BOX_NAME}."
            fi
        fi
        if podman volume exists "${VOLUME}"; then
            if confirm "Delete home volume ${VOLUME}? (logins, installed agent tools, and settings are lost)"; then
                podman volume rm "${VOLUME}" >/dev/null; log "Deleted volume ${VOLUME}."
            else
                log "Kept volume ${VOLUME}."
            fi
        fi
        tags="$(podman images --format '{{.Repository}}:{{.Tag}}' | grep -F "${repo}:" || true)"
        if [[ -n "${tags}" ]]; then
            log "Images: ${tags//$'\n'/ }"
            if confirm "Delete these images?"; then
                # shellcheck disable=SC2086
                podman rmi ${tags} >/dev/null; log "Deleted the images."
            else
                log "Kept the images."
            fi
        fi
    else
        log "podman is not installed; skipping the container, volume, and image."
    fi
    if [[ -L "${BIN_DIR}/airlock" && "$(readlink "${BIN_DIR}/airlock")" == "${SCRIPT_DIR}/airlock" ]]; then
        rm "${BIN_DIR}/airlock"
        log "Removed ${BIN_DIR}/airlock."
    fi
    if [[ -d "${CONFIG_DIR}" ]]; then
        if confirm "Delete config directory ${CONFIG_DIR}? (a stored env file may hold API keys)"; then
            rm -r "${CONFIG_DIR}"; log "Deleted ${CONFIG_DIR}."
        else
            log "Kept ${CONFIG_DIR}."
        fi
    fi
    log "Left untouched: ${GIT_DIR}, podman itself, and this repository folder."
    if selinux_active && git_dir_relabeled; then
        log "To undo the one-time SELinux relabel: restorecon -R ${GIT_DIR}"
    fi
}

### Dispatch ###
main() {
    local command="${1:-}"
    [[ -n "${command}" ]] || { usage; exit 1; }
    shift
    case "${command}" in
        install)   cmd_install "$@" ;;
        build)     cmd_build "$@" ;;
        up)        cmd_up "$@" ;;
        down)      cmd_down ;;
        shell)     cmd_shell ;;
        vscode)    cmd_vscode "$@" ;;
        code)      cmd_vscode --container "$@" ;;
        open)      cmd_vscode --host "$@" ;;
        attach)    cmd_attach ;;
        login)     cmd_login "$@" ;;
        update)    cmd_update ;;
        snapshot)  cmd_snapshot "$@" ;;
        status)    cmd_status ;;
        doctor)    cmd_doctor ;;
        reset)     cmd_reset "$@" ;;
        uninstall) cmd_uninstall ;;
        -h|--help|help) usage ;;
        *) usage; die "unknown command: ${command}" ;;
    esac
}

main "$@"
